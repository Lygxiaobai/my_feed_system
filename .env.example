# 复制本文件为 .env 并填入真实值后再启动 docker compose。
# .env 已被 .gitignore 排除，不会进入 Git，切勿把真实密钥写进本文件。
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
RABBITMQ_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret

# 以下为可选项，不设置时使用括号内的默认值。
# BACKEND_PORT=8080
# FRONTEND_PORT=5173
# RABBITMQ_MANAGEMENT_PORT=15672
# LOG_LEVEL=info
# LOG_FORMAT=json
