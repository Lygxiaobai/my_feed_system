# 本地开发环境变量模板。
#
# 用法：cp backend/.env.example backend/.env 并填入真实值，
# 程序启动时会自动读取（.env 已被 .gitignore 排除，不会进入 Git）。
# 已存在的环境变量优先于本文件，CI 与容器部署直接注入即可，无需本文件。

# ---- 必填：缺失会导致启动失败 ----
# 本地 MySQL 的 root 密码
MYSQL_PASSWORD=
# 本地 RabbitMQ 密码（默认安装通常是 guest）
RABBITMQ_PASSWORD=guest
# JWT 签名密钥，至少 32 位。生成：openssl rand -base64 48
JWT_SECRET=

# ---- 选填：不设置则使用配置文件里的默认值 ----
# SERVER_PORT=8081
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_DATABASE=my_feed_system
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# RABBITMQ_HOST=127.0.0.1
# RABBITMQ_USER=guest
# 本地排查问题时可临时调成 debug
# LOG_LEVEL=info
# LOG_FORMAT=text
# 内容审核，默认关闭。设为 true 后发布需过审才进入信息流
# AUDIT_ENABLED=false
