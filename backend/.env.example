# 本地开发环境变量模板。
#
# 用法：cp backend/.env.example backend/.env 并填入真实值，
# 程序启动时会自动读取（.env 已被 .gitignore 排除，不会进入 Git）。
# 已存在的环境变量优先于本文件，CI 与容器部署直接注入即可，无需本文件。

# ---- 必填：缺失会导致启动失败 ----
# 本地 MySQL 的 root 密码
MYSQL_PASSWORD=
# 本地 RabbitMQ 密码（默认安装通常是 guest）
RABBITMQ_PASSWORD=guest
# JWT 签名密钥，至少 32 位。生成：openssl rand -base64 48
JWT_SECRET=

# ---- 选填：不设置则使用配置文件里的默认值 ----
# SERVER_PORT=8081
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_DATABASE=my_feed_system
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# RABBITMQ_HOST=127.0.0.1
# RABBITMQ_USER=guest
# 本地排查问题时可临时调成 debug
# LOG_LEVEL=info
# LOG_FORMAT=text
# 内容审核，默认关闭。设为 true 后发布需过审才进入信息流
# AUDIT_ENABLED=false
# 网易 SMTP。USER/PASSWORD 不填时普通邮箱无法发码，数字@lmr.com 测试邮箱仍可用
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_TLS=ssl
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# 关注流推拉结合。粉丝数低于 PUSH 阈值全量写扩散，介于两阈值之间只推活跃粉丝，
# 达到 PULL 阈值后完全不推、由粉丝读取时从作者发件箱拉取。
# 本地或测试环境想实际跑通这两条分支，把阈值调到几十即可。
# FEED_FANOUT_PUSH_THRESHOLD=5000
# FEED_FANOUT_PULL_THRESHOLD=100000
# FEED_FANOUT_BATCH_SIZE=1000
# FEED_FANOUT_INBOX_MAX_SIZE=1000
# FEED_FANOUT_OUTBOX_MAX_SIZE=200
# FEED_FANOUT_ACTIVE_TTL_HOURS=168
# FEED_FANOUT_MAX_PULL_AUTHORS=20
# LOKI_URL=http://127.0.0.1:3100
# PROMETHEUS_URL=http://127.0.0.1:9090
# 支付宝沙箱。不填则充值接口返回「支付未配置」。私钥里的换行写成 \n
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_NOTIFY_URL=http://127.0.0.1:5173/api/wallet/alipay/notify
# ALIPAY_RETURN_URL=http://127.0.0.1:5173/wallet
